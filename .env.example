# Where generated synthetic data lives (make data writes here)
SA_DATA_DIR=data/generated
# Postgres everywhere (dev + prod). Start it with `make db-up` (docker-compose service).
# Host port 5433 so it coexists with the existing backend postgres_db on 5432.
SA_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent
# Fallback for a quick offline run with no database server:
# SA_DATABASE_URL=sqlite:///./servicing_agent.db

# Verification
SA_OTP_ENABLED=true
# Stub OTP code accepted by the mock OTP service (simulate / eval harness only)
SA_OTP_STUB_CODE=123456
SA_HELPLINE=1800-000-0000

# Planner: "rules" (deterministic, no API key needed) or "llm" (Claude via the anthropic SDK)
SA_PLANNER=rules
SA_PLANNER_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=...

# Perception: "stub" (pre-extracted hints, no network) or "sarvam" (real speech-to-text + Document AI)
SA_PERCEPTION=stub
# One Sarvam subscription key covers speech-to-text, Document AI and the chat models.
# Put the real key in .env only; .env is git-ignored.
# SARVAM_API_KEY=...
# Translate regional / code-mixed typed text before planning: "off" or "sarvam" (same SARVAM_API_KEY)
SA_NORMALIZER=off
SA_NORMALIZER_MODEL=sarvam-105b-conversations
SA_NORMALIZER_FALLBACK_MODEL=deepseekv4.1-flash-1017
# Where uploaded images and voice notes are stored (git-ignored)
SA_MEDIA_DIR=data/media

# Payment settlement window (hours) before an unmatched UTR is sent to reconciliation
SA_SETTLEMENT_WINDOW_HOURS=24

# LangSmith tracing (optional). Every agent turn becomes a trace named "servicing_turn".
# Keep inputs/outputs hidden until PII masking exists: traces then show the graph steps,
# timings, tags and errors, but no borrower text, numbers or account data.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=inbound-servicing-agent
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# WhatsApp Cloud API (Meta Graph). Leave blank for local/sim runs (MockChannel).
# NEVER commit real values — keep them in .env only (gitignored).
# SA_WHATSAPP_TOKEN=            # Bearer token (rotate if ever exposed)
# SA_WA_PHONE_NUMBER_ID=        # the /{phone_number_id} the send POSTs to
SA_WA_API_VERSION=v25.0
# SA_WA_VERIFY_TOKEN=           # your own string; must match the webhook config in Meta
SA_GRAPH_BASE_URL=https://graph.facebook.com

# Public tunnel for the Meta webhook (scripts/run.sh).
# Set NGROK_DOMAIN to a RESERVED ngrok domain -> the callback URL is stable across restarts,
# so you paste it into Meta > WhatsApp > Configuration only once.
#   1. ngrok config add-authtoken <token>        (one-time, from dashboard.ngrok.com)
#   2. reserve a free domain at dashboard.ngrok.com/domains (1 free per account)
#   3. set it below (each teammate uses their own reserved domain)
# If unset, run.sh falls back to a cloudflared quick-tunnel (URL rotates every run).
# NGROK_DOMAIN=cn-sa.ngrok-free.app
